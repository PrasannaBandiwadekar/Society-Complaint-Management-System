
# MySQL root password (used inside Docker only)
MYSQL_ROOT_PASSWORD=choose_a_password

# Gmail SMTP credentials
# Generate App Password: Google Account → Security → 2-Step Verification → App Passwords
# Paste the 16-char password WITHOUT spaces
SPRING_MAIL_USERNAME=your-gmail@gmail.com
SPRING_MAIL_PASSWORD=your16charapppassword

# Default admin account — seeded automatically on first startup
APP_DEFAULT_ADMIN_EMAIL=admin@society.com
APP_DEFAULT_ADMIN_PASSWORD=ChooseAStrongPassword123

# JWT signing secret — any long random string (min 32 characters)
APP_JWT_SECRET=ReplaceThisWithALongRandomSecretStringAtLeast32CharsLong
